{
  "name": "kanbo-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @kanbo/web dev",
    "build": "pnpm --filter @kanbo/web build",
    "preview": "pnpm --filter @kanbo/web preview",
    "typecheck": "tsc --build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:network": "node scripts/check-network-boundary.ts",
    "smoke": "node scripts/smoke.ts",
    "build:dist": "node scripts/build-dist.ts",
    "check:dist": "node scripts/check-dist.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm build:dist && pnpm check:network && pnpm check:cli && pnpm check:parity && pnpm check:mcp && pnpm check:forge && pnpm check:skill && pnpm check:version && pnpm check:dist && pnpm smoke",
    "check:cli": "node scripts/check-cli.ts",
    "check:parity": "node scripts/check-parity.ts",
    "check:mcp": "node scripts/check-mcp.ts",
    "check:forge": "node scripts/check-forge.ts",
    "check:skill": "node scripts/check-skill.ts",
    "check:version": "node scripts/sync-version.mjs --check"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "oxlint": "^1.77.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
